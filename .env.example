# Copia este archivo como .env y completa los valores. El .env NO se sube a git.

# --- Django ---
# Una clave larga y aleatoria. Para generar una:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
# True solo en desarrollo
DEBUG=True
# Dominios desde donde se sirve la API, separados por coma
ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
DB_NAME=prestamos_sistema
DB_USER=postgres
DB_PASSWORD=tu-password
DB_HOST=localhost
DB_PORT=5432

# --- Frontend ---
# Se usa para el enlace del correo de "olvide mi contrasena"
FRONTEND_URL=http://localhost:5173
# Desde que direcciones puede llamar el navegador a la API (CORS), separadas por coma.
# Si no se pone, se usa FRONTEND_URL.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Correo ---
# console: los correos se imprimen en la terminal del servidor (desarrollo)
# smtp: se envian de verdad con los datos de abajo
EMAIL_BACKEND=console
DEFAULT_FROM_EMAIL=Sistema de Prestamos <no-responder@localhost>
# Solo si EMAIL_BACKEND=smtp (con Gmail, usar una "contrasena de aplicacion")
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
